// AlphaScope 댓글 — Firestore 보안 규칙 (2026-10-14 사용자: "우리가 댓글 프로그램을 만드는 건 어때?")
//
// 블로거 댓글(blogger.com iframe)은 아이폰 사파리가 다른 도메인 쿠키를 막아 로그인을 못 보고,
// 전체 페이지는 구글 CSS 라 폰에서 입력창이 좁다(좌 48 · 우 16). 그래서 댓글을 우리 페이지 안에서
// Firebase 로 돌린다. 테마 JS 는 Firestore REST 로 읽고 쓰며, 로그인은 Firebase Auth(Google 팝업).
//
// 구조:  posts/{postId}/comments/{commentId}
//   uid      작성자 Firebase UID
//   name     표시 이름 (Google 프로필 이름)
//   photo    프로필 사진 URL ('' 가능)
//   text     댓글 글 (1 ~ 2000자)
//   created  서버 시각 (REQUEST_TIME 변환으로만 넣는다)
//   parent   답글이면 원 댓글 ID (없으면 최상위 댓글)
//
// 블로그 주인(아래 isOwner 의 UID — 2026-10-14 사용자 계정 "keep red6")은 모든 댓글을 지울 수 있다. 수정은 없다 — 지우고 다시 쓴다.
// 적용: Firebase 콘솔 → Firestore Database → 규칙 → 이 파일 내용 붙여넣기 → 게시.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == 'u1vln4bbDgSgWQDe2F2FaNs81D43'; }

    // 쓰기 남용 방어 (2026-10-21, doc/블로그-운영-지침.md D7-4). 전에는 로그인만 하면 아무 postId 아래에 무제한으로 쓸 수 있었다.
    //  ① postId 는 블로거 글 ID(숫자 5~25자리) 모양이어야 한다 — 임의 경로에 쓰레기를 쌓지 못하게
    //  ② 답글(parent)은 같은 글의 실제 댓글을 가리켜야 한다 (exists = 읽기 1회)
    //  ③ 같은 사람은 20초에 한 번 — 테마 JS 가 댓글과 함께 users/{uid}.last 를 같은 commit 으로 쓴다 (alphaflow-home.html store.add).
    //     users 문서가 없으면(옛 테마) 통과 → 테마를 새로 붙여넣은 뒤부터 제한이 걸린다
    function postIdOk(postId) { return postId.matches('^[0-9]{5,25}$'); }
    function parentOk(postId, data) {
      return !('parent' in data)
        || (data.parent is string && data.parent.size() <= 40
            && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(data.parent)));
    }
    function notTooFast() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.last < request.time - duration.value(20, 's');
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if true;

      allow create: if signedIn()
        && postIdOk(postId)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photo', 'text', 'created', 'parent'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 60
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 400
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
        && request.resource.data.created == request.time
        && parentOk(postId, request.resource.data)
        && notTooFast();

      allow update: if false;

      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
    }

    // 사용자별 마지막 댓글 시각 — 본인만, 필드는 last 하나, 값은 서버 시각
    match /users/{uid} {
      allow read: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
