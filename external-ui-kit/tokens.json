        "body": { "size": 19, "lineHeight": 34, "weight": 400, "inCardLineHeight": 24 },
        "cardName": { "size": 16, "lineHeight": 24, "weight": 700 },
        "cardValue": { "size": 19, "lineHeight": 24, "weight": 700 },
        "button": { "size": 16, "lineHeight": 24, "weight": 700 },
        "small": { "size": 14, "lineHeight": 20, "weight": 400 },
        "nav": { "size": 19, "lineHeight": 26, "weight": 700 },
        "tab": { "size": 19, "lineHeight": 24 },
        "cardTab": { "size": 17, "lineHeight": 23 }
