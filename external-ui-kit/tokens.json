    "popup": "0 12px 40px rgba(0,0,0,0.25)",
    "float": "0 8px 30px rgba(15,23,42,0.18)",
    "drawer": "-8px 0 30px rgba(15,23,42,0.18)",
    "search": "0 8px 24px rgba(15,23,42,0.14)",
    "segment": "0 1px 3px rgba(0,0,0,0.12)"
  },
  "spacing": {
    "rule": "정수 px만. 여백은 보이는 거리 = padding + 행간 반쪽",
    "visibleVertical": { "emphasisCard": 24, "rowCard": 22, "basicCard": 14, "noticeBox": 12, "foldButton": 10 },
    "cardHorizontal": [12, 14],
    "dashboardCardPadding": { "y": 16, "x": 10 },
    "cardHead": { "top": 14, "bottom": 13, "inset": 16 },
    "rowColumns": { "default": [65, 35], "shortValues": [80, 20] },
    "bulletGap": { "body": 12, "inCard": 9, "small": 8 },
    "bulletIndentOutsideCard": 14,
    "guideIndentOutsideCard": 12,
    "labelMargin": 5,
    "sectionTitle": { "top": 28, "bottom": 11, "underlineGap": 6 }
  },
  "component": {
    "buttonBlack": { "bg": "#111111", "text": "#FFFFFF", "padding": [12, 42], "paddingSmall": [8, 24], "radius": 8, "hoverBg": "#000000" },
    "buttonWhite": { "bg": "#FFFFFF", "border": "#B5BAC0", "text": "#111111", "padding": [11, 12], "radius": 8, "hoverBorder": "#111111", "fullWidth": true },
    "buttonOutlineSmall": { "border": "#E2E8F0", "fontSize": 14, "padding": [5, 12], "radius": 8, "hoverBorder": "#111111" },
    "iconButton": { "size": [32, 36], "border": "#E2E8F0", "radius": 8, "hoverBorder": "#111111" },
    "textButton": { "fontSize": 14, "color": "#7A7A7A", "underlineOffset": 3, "hoverColor": "#111111" },
    "foldButton": { "fontSize": 14, "weight": 700, "padding": [13, 12, 8, 12], "borderTop": "#E2E8F0", "chevron": 16, "openLabel": "접기" },
    "label": { "fontSize": 14, "padding": [3, 5, 2, 5], "radius": 4, "lineHeight": 1 },
    "iconTile": { "size": 24, "icon": 16, "radius": 6, "gapToText": 8 },
    "popup": { "maxWidth": 520, "maxHeightVh": 80, "radius": 12, "headPadding": [20, 60, 12, 20], "bodyPadding": [12, 20, 22, 20], "close": 32 },
    "input": { "padding": [11, 12], "radius": 8, "minHeight": 118, "focusBorder": "#111111" },
    "search": { "height": 41, "padding": [8, 14], "radius": 8 },
    "bullet": { "dotBody": 3, "dotSmall": 2, "gapToText": 7 },
    "tooltipIcon": { "size": 20, "stroke": 1.5, "margin": 3 }
  },
  "motion": { "colorMs": 150, "chevronMs": 150, "cardLiftMs": 180, "drawerMs": 220 }
}
