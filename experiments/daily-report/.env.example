# .env.example — 이 파일을 복사해서 .env 로 만든 뒤 실 값을 채우세요.
# 절대 이 파일에 실 키 값을 입력하지 마세요 (커밋 위험). .env 는 gitignore 에 등록되어 있습니다.
#
# 로컬 테스트에서만 사용되며, GitHub Actions 는 같은 이름의 키를
# Settings > Secrets and variables > Actions 의 Secret 으로 읽습니다.

# FRED API 키 (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Gemini API 키 (https://aistudio.google.com/app/apikey)
# 여러 키를 세미콜론(;) 또는 쉼표(,)로 구분해 넣으면 앞 키가 허용량 초과 시 다음 키로 자동 넘어갑니다.
# 예) GEMINI_API_KEY=키1;키2;키3;키4;키5  /  GEMINI_API_KEY=키1,키2,키3,키4,키5
GEMINI_API_KEY=

# Gemini 모델 (기본값: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Hugging Face Access Token (https://huggingface.co/settings/tokens, Read 권한)
# 커버 이미지 fallback용 — Pollinations.ai 실패 시에만 사용 (선택)
HF_TOKEN=

# Blogger 게시용 OAuth 2.0 (데스크톱 클라이언트) — 자동 게시 시 필요
# 1) Google Cloud Console에서 OAuth 클라이언트 ID(데스크톱 앱) 생성 → client_secret.json 다운로드
# 2) Blogger API 활성화, OAuth consent screen 을 Publishing(Production)으로 전환
# 3) python experiments/daily-report/setup_oauth.py <client_secret.json 경로>
#    → 아래 3개 값 발급 (client_secret.json 은 repo 밖에 보관, 추출 후 삭제 권장)
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# 블로그 URL (기본: 알파스코프)
BLOG_URL=http://alpha-scope.blogspot.com/

# true 이면 --publish 없이도 게시함
PUBLISH_BLOG=false