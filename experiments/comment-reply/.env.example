# .env.example — 복사해서 .env로 만든 뒤 실 값을 채우세요. 로컬 테스트 전용.
# GitHub Actions는 같은 이름의 키를 Settings > Secrets and variables > Actions 에서 읽습니다.

# Blogger OAuth (daily-report 에서 발급한 값 재사용 가능 — 리포 루트 .env 참고)
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# 블로그 URL (기본: 알파스코프)
BLOG_URL=http://alpha-scope.blogspot.com/

# Gemini API 키 (리포 루트 .env 값 재사용, 다중 키 ; 또는 , 구분 가능)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Slack 알림 (앱 > Incoming Webhooks 에서 Webhook URL 생성)
SLACK_WEBHOOK_URL=